{
  "expo": {
    "name": "Lark Media Player",
    "slug": "lark-media-player",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "splash": {
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mazharmnzoor.larkmediaplayer",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Allow access to your music library so Lark can play your local songs.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.mazharmnzoor.larkmediaplayer",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ],
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your media library.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save media.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-av"
    ]
  }
}
